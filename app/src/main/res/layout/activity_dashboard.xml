<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Video Upload Demo" android:textSize="24sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:text="Pilih video dari perangkat, lihat pratinjau, lalu unggah ke folder Storage akun Anda. Aplikasi ini belum menampilkan katalog upload." />
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/addvideo"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:src="@android:drawable/ic_input_add" android:contentDescription="Tambah video" />
    <Button android:id="@+id/logout" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="Logout" />
</LinearLayout>
